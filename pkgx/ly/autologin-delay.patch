+fn autologinTimeout(ptr: *anyopaque) !?usize {
+    const state: *UiState = @ptrCast(@alignCast(ptr));
+    const deadline = state.autologin_deadline orelse return null;
+    const remaining = std.Io.Clock.awake.now(state.io).durationTo(deadline).toMilliseconds();
+    if (remaining > 0) return @intCast(remaining);
+
+    state.autologin_deadline = null;
+    _ = try authenticate(state);
+    return 0;
+}
+
+fn cancelAutologin(ptr: *anyopaque) bool {
+    const state: *UiState = @ptrCast(@alignCast(ptr));
+    if (state.autologin_deadline == null) return false;
+
+    state.autologin_deadline = null;
+    state.is_autologin = false;
+    return true;
+}
